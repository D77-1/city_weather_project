page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'SF Pro Display', sans-serif;
  background: linear-gradient(180deg, #f0f4f8 0%, #e8edf5 100%);
  font-size: 28rpx;
  color: #1e293b;
}

/* 通用卡片 — 毛玻璃效果 */
.card {
  margin: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #1e293b;
}

/* 天气图标样式 — 替代 emoji */
.weather-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}
.weather-icon.sunny { background: linear-gradient(135deg, #f59e0b, #f97316); }
.weather-icon.cloudy { background: linear-gradient(135deg, #94a3b8, #64748b); }
.weather-icon.overcast { background: linear-gradient(135deg, #64748b, #475569); }
.weather-icon.rain { background: linear-gradient(135deg, #0ea5e9, #0284c7); }
.weather-icon.heavy-rain { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
.weather-icon.snow { background: linear-gradient(135deg, #a5b4fc, #818cf8); }
.weather-icon.thunder { background: linear-gradient(135deg, #7c3aed, #6d28d9); }
.weather-icon.fog { background: linear-gradient(135deg, #cbd5e1, #94a3b8); }

/* 数字等宽 */
.num {
  font-family: 'DIN Alternate', 'Menlo', monospace;
  font-variant-numeric: tabular-nums;
}
