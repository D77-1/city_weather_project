page { display: flex; flex-direction: column; height: 100vh; }

.msg-list { flex: 1; padding: 24rpx; padding-bottom: 150rpx; }

.welcome {
  text-align: center;
  padding: 90rpx 36rpx 40rpx;
}
.welcome-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #a8743f;
}
.welcome-title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 16rpx 0 10rpx;
  color: #1a2529;
}
.welcome-text {
  font-size: 26rpx;
  color: #5c686c;
  line-height: 1.7;
}
.quick-list { margin-top: 34rpx; display: flex; flex-direction: column; gap: 16rpx; align-items: center; }
.quick-btn {
  background: rgba(252, 249, 243, 0.9);
  border: 1rpx solid rgba(26, 37, 41, 0.08);
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  color: #1e5c5a;
  box-shadow: 0 8rpx 22rpx rgba(54, 45, 32, 0.05);
}

.msg-row { display: flex; margin-bottom: 22rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.ai { justify-content: flex-start; }

.msg-bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.msg-bubble.user {
  background: linear-gradient(135deg, #1e5c5a, #28474c);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}
.msg-bubble.ai {
  background: rgba(252, 249, 243, 0.92);
  color: #1a2529;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 8rpx 22rpx rgba(54, 45, 32, 0.05);
  border: 1rpx solid rgba(26, 37, 41, 0.08);
}
.msg-meta { font-size: 20rpx; color: #8a918f; margin-top: 8rpx; }

.typing { display: flex; gap: 8rpx; padding: 8rpx 0; }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #a7afab; animation: blink 1.4s infinite both;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

.input-area {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 24rpx; background: rgba(252, 249, 243, 0.96);
  border-top: 1rpx solid rgba(26, 37, 41, 0.08);
  position: fixed; bottom: 0; left: 0; right: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input-box {
  flex: 1; height: 76rpx; background: #f1ebe2; border-radius: 999rpx;
  padding: 0 28rpx; font-size: 28rpx;
}
.send-btn {
  width: 120rpx; height: 76rpx;
  background: linear-gradient(135deg, #1e5c5a, #a8743f);
  color: #fff; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
}
.send-btn.disabled { opacity: 0.5; }
