.page-head {
  padding: 28rpx 28rpx 8rpx;
}

.page-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #a8743f;
}

.page-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a2529;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c686c;
}

.hero {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 14rpx 36rpx rgba(33, 28, 21, 0.08);
  border: 1rpx solid rgba(255,255,255,0.45);
}
.hero-name { font-size: 32rpx; color: #4a5a61; }
.hero-aqi { font-size: 100rpx; font-weight: 800; line-height: 1.2; letter-spacing: -4rpx; }
.hero-level { font-size: 34rpx; font-weight: 700; }

.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; color: #1a2529; }
.advice-text { font-size: 26rpx; color: #4a5a61; line-height: 1.8; }

.weather-row { display: flex; align-items: center; }
.weather-main { text-align: center; width: 160rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.weather-svg { width: 64rpx; height: 64rpx; }
.weather-cond { font-size: 28rpx; font-weight: 600; color: #1a2529; }
.weather-detail { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx; }
.wd-item {
  flex: 1; min-width: 140rpx; text-align: center;
  background: #f1ebe2; border-radius: 14rpx; padding: 12rpx 8rpx;
}
.wd-val { font-size: 26rpx; font-weight: 700; color: #1a2529; display: block; }
.wd-label { font-size: 20rpx; color: #8a918f; }

.p-row { display: flex; align-items: center; padding: 12rpx 0; }
.p-label { width: 100rpx; font-size: 24rpx; color: #4a5a61; }
.p-bar-wrap {
  flex: 1; height: 16rpx; background: #efe8dd;
  border-radius: 8rpx; margin: 0 16rpx; overflow: hidden;
}
.p-bar { height: 100%; border-radius: 8rpx; transition: width 0.5s ease; }
.p-val { font-size: 26rpx; font-weight: 700; width: 80rpx; text-align: right; }
.p-limit { font-size: 20rpx; color: #8a918f; width: 60rpx; }

.chart-canvas { width: 100%; height: 300rpx; }

.pred-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pred-item {
  flex: 1; min-width: 130rpx; text-align: center;
  background: #f1ebe2; border-radius: 16rpx; padding: 16rpx 8rpx;
}
.pred-date { font-size: 22rpx; color: #8a918f; }
.pred-val { font-size: 36rpx; font-weight: 800; margin: 4rpx 0; }
.pred-range { font-size: 18rpx; color: #8a918f; }

.fc-scroll { white-space: nowrap; }
.fc-row { display: inline-flex; gap: 12rpx; }
.fc-card {
  width: 140rpx; text-align: center;
  background: #f1ebe2; border-radius: 16rpx; padding: 14rpx 8rpx;
  display: inline-block;
}
.fc-day { font-size: 24rpx; font-weight: 600; color: #1a2529; }
.fc-date { font-size: 20rpx; color: #8a918f; }
.fc-svg { width: 44rpx; height: 44rpx; margin: 6rpx auto; display: block; }
.fc-text { font-size: 20rpx; color: #4a5a61; }
.fc-temp { font-size: 26rpx; font-weight: 700; color: #1a2529; margin-top: 4rpx; }
.fc-rain { font-size: 18rpx; color: #8a918f; }

.bottom-btn {
  position: fixed; bottom: 0; left: 0; right: 0; height: 120rpx;
  background: linear-gradient(135deg, #1e5c5a, #28474c);
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600;
  padding-bottom: env(safe-area-inset-bottom);
}

.source-tag {
  font-size: 20rpx; color: #fff; background: #1e5c5a;
  padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 12rpx; font-weight: 400;
}
.real-aqi-card { border-left: 4rpx solid #1e5c5a; }
.real-aqi-row { display: flex; align-items: center; gap: 16rpx; }
.real-aqi-hero { text-align: center; width: 140rpx; }
.real-aqi-num { font-size: 64rpx; font-weight: 800; display: block; line-height: 1.1; }
.real-aqi-level { font-size: 24rpx; color: #4a5a61; }
.real-aqi-grid { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx; }
.raq-item {
  flex: 1; min-width: 120rpx; text-align: center;
  background: #f1ebe2; border-radius: 14rpx; padding: 10rpx 6rpx;
}
.raq-val { font-size: 28rpx; font-weight: 700; color: #1a2529; display: block; }
.raq-lbl { font-size: 20rpx; color: #8a918f; }
.real-aqi-source { font-size: 20rpx; color: #8a918f; margin-top: 12rpx; }
